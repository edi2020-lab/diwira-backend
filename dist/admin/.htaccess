<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/

  # Serve actual files/dirs directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback → admin/index.html (React Router)
  RewriteRule ^ /admin/index.html [L]
</IfModule>
